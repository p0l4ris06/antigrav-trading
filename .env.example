# =============================================================================
# ANTIGRAV TRADING ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Gateway & API Ports
AG_HOST=0.0.0.0
AG_PORT=8000
AG_ENV=development # development | staging | production

# Alpaca Markets API Credentials (Real-Time Market Data & Assets)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true

# Trading 212 API Credentials (Live Order Execution)
T212_API_KEY=your_t212_api_key_here
T212_ENV=demo # demo | live

# Telemetry & Observability
AG_OTEL_ENABLED=false
AG_LOG_LEVEL=INFO # DEBUG | INFO | WARNING | ERROR

# ClickHouse Storage (Optional Market Data Persistence)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
